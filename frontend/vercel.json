{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!api/|img/|assets/|data/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60,
      "includeFiles": "{server/models/**,public/data/faces.json,node_modules/@tensorflow/tfjs-backend-wasm/dist/*.wasm}"
    }
  }
}
